---
import Theme from "@/icons/themeSwitch.astro";
---

<div class="no-print inline-flex items-center">
	<!-- <div class="flex items-center gap-1">
		<Theme />
		<select name="themeSwitch" id="themeSwitch" class="block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 dark:text-gray-100 dark:ring-gray-700 sm:text-sm sm:leading-6">
			<option value="system">System</option>
			<option value="dark">Dark</option>
			<option value="light">Light</option>
		</select>
	</div> -->

	<div class="group/theme flex items-center gap-2">
		<label for="themeSwitch" class="flex items-center gap-1 text-sm font-medium leading-6 text-skin-base transition-transform ease-in-out group-hover/theme:rotate-45">
			<Theme />
		</label>
		</span>
		<button id="themeSwitch" type="button" aria-label="Toggle dark mode"
			class="theme-toggle relative w-12 h-6 rounded-full transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-skin-hue
				bg-gray-300 dark:bg-gray-700">
			<span class="sr-only">Toggle dark mode</span>
			<span class="toggle-thumb absolute left-0 top-0 w-6 h-6 rounded-full shadow-md transform transition-transform duration-300
				bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700"></span>
		</button>
		</button>
	</div>

	<style>
		:global(.dark) {
			color-scheme: dark;
		}
	</style>

	<script>
		window.addEventListener('DOMContentLoaded', () => {
			const button = document.getElementById("themeSwitch") as HTMLElement | null;
			const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			let theme: string = localStorage.getItem("theme") || systemTheme;

			function setTheme(newTheme: string) {
				theme = newTheme;
				updateThumb();
				document.documentElement.classList.remove("light", "dark");
				document.documentElement.classList.add(newTheme);
				localStorage.setItem("theme", newTheme);
			}

			function updateThumb() {
				if (!button) return;
				const thumb = button.querySelector('.toggle-thumb') as HTMLElement | null;
				if (!thumb) return;
				if (theme === "dark") {
					thumb.style.transform = "translateX(100%)";
				} else {
					thumb.style.transform = "translateX(0)";
				}
			}

			setTheme(theme);

			button?.addEventListener("click", () => {
				setTheme(theme === "dark" ? "light" : "dark");
			});

			// Ensure toggle updates if theme changes outside the button
			const observer = new MutationObserver(() => {
				const currentTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";
				if (theme !== currentTheme) {
					theme = currentTheme;
					updateThumb();
				}
			});
			observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
		});
	</script>
</div>
