---
import { icon } from "@fortawesome/fontawesome-svg-core";

export interface Props {
  iconObj: any;
  className?: string;
  title?: string;
}

const { iconObj, className = "", title = "" } = Astro.props;
const rendered = iconObj ? icon(iconObj) : null;
---
{rendered ? <Fragment set:html={rendered.html} class={className} title={title} /> : null}

<style is:global>
  .svg-inline--fa {
    overflow: visible;
    box-sizing: content-box;
    display: inline-block;
    vertical-align: -0.125em;
  }
</style>
