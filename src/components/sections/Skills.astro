---

import Section from "../Section.astro";
import { skills as importedSkills } from "@cv";

import * as brands from "@fortawesome/free-brands-svg-icons";
import * as solids from "@fortawesome/free-solid-svg-icons";
import FontAwesomeIcon from "@/components/FontAwesomeIcon.astro";

type Skill = {
  name: string;
  level?: number | string;
  category?: string;
  faIcon?: string;
};

const skills: Skill[] = importedSkills as Skill[];

// Group skills by category in frontmatter
const groupedSkills: Record<string, Skill[]> = {};
for (const skill of skills) {
  const cat = skill.category || 'Other';
  if (!groupedSkills[cat]) groupedSkills[cat] = [];
  groupedSkills[cat].push(skill);
}
const groupedEntries = Object.entries(groupedSkills);
---


<Section className={Astro.props.className} title="Skills">
  {
    groupedEntries.map(([category, skillsInCategory]) => (
      <div class="mb-6">
        <h3 class="mb-2 text-base font-semibold text-skin-accent print:text-zinc-800">{category}</h3>
        <ul class="[&>li>svg]:text-skin-hue inline-flex flex-wrap gap-2 [&>li>svg]:size-5 [&>li]:text-sm">
          {
            skillsInCategory.map((skill) => {
              const { name, faIcon } = skill;
              let iconObj = null;
              if (faIcon) {
                const iconKey = "fa" + faIcon.charAt(0).toUpperCase() + faIcon.slice(1).replace(/-([a-z])/g, (_, c) => c.toUpperCase());
                iconObj = (brands as any)[iconKey] || (solids as any)[iconKey];
              }
              return (
                <li class="border border-skin-hue bg-skin-button-muted flex items-center gap-1 rounded-lg px-3 py-1 text-xs text-skin-muted shadow-sm print:border-none print:bg-transparent print:p-0 print:text-zinc-800">
                  {iconObj && <FontAwesomeIcon iconObj={iconObj} />}
                  {iconObj && <div class="mr-1" />}
                  <span>{name}</span>
                </li>
              );
            })
          }
        </ul>
      </div>
    ))
  }
</Section>
