---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import IconUnibo from "@/assets/icons/IconUnibo.svg"

const experience = [
  {
    company: "Company Name",
    role: "Frontend Developer",
    start: "2024",
    end: "Present",
    location: "Remote",
    url: "https://example.com",
    summary:
      "Built and shipped user-facing features, improved performance, and collaborated closely with design and backend.",
    highlights: [
      "Shipped 8+ features across onboarding and dashboard experiences.",
      "Improved Lighthouse performance by optimizing images and reducing JS payload.",
      "Introduced reusable UI patterns and improved accessibility.",
    ],
    stack: ["Astro", "TypeScript", "React", "Tailwind"],
  },
  {
    company: "Previous Company",
    role: "Web Developer",
    start: "2022",
    end: "2024",
    location: "City, Country",
    url: "",
    summary:
      "Maintained marketing site and internal tools, integrated APIs, and reduced regressions with testing.",
    highlights: [
      "Built responsive pages and componentized layouts for faster iteration.",
      "Integrated REST APIs and improved loading/error handling states.",
    ],
    stack: ["Next.js", "Node.js", "PostgreSQL"],
  },
];

const skills = [
  { group: "Frontend", items: ["Astro", "React", "Next.js", "HTML", "CSS", "TypeScript"] },
  { group: "Backend", items: ["Node.js", "REST APIs", "SQL (basic)", "Auth (basic)"] },
  { group: "Tooling", items: ["Git", "Vite", "CI/CD (basic)", "Jest/Vitest (basic)"] },
  { group: "Design", items: ["Figma handoff", "Responsive UI", "Accessibility"] },
];

const education = [
    {
    school: "University of Bologna",
    degree: "M.Sc. Computer Science and Engineering",
    start: "Sep. 2020",
    end: "Mar. 2023",
    details: [
      "Relevant coursework: Algorithms, Databases, Web Development",
      'Thesis title: <em>Design and Implementation of a Portable Framework for Application Decomposition and Deployment for Edge-Cloud Systems</em>',
    ],
  },
  {
    school: "University of Bologna",
    degree: "B.Sc. Computer Science and Engineering",
    start: "Sep. 2016",
    end: "Mar. 2020",
    details: [
      "Relevant coursework: Algorithms, Databases, Web Development",
      "Capstone/Thesis: (optional) …",
    ],
  },
];
---

<Layout>
  <Header />

  <main id="main-content" class="app-layout">
    <!-- EXPERIENCE -->
    <section id="experience" class:list={["pt-2 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-2xl font-bold sm:my-8 sm:text-4xl">Experience</h1>

      <ol class="grid gap-4">
        {experience.map((job) => (
          <li class="relative rounded-lg border border-border bg-neutral-secondary-soft p-6 flex flex-col gap-2 shadow-sm">
            <div class="flex flex-col gap-3">
              {/* Top row: title + dates (dates right-aligned to title) */}
              <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-baseline">
                <h2 class="text-lg font-bold leading-snug">
                  <span>{job.role}</span>
                  <span class="text-foreground/60"> @ </span>
                  {job.url ? (
                    <a
                      class="underline decoration-dashed underline-offset-4 hover:text-foreground/75"
                      href={job.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {job.company}
                    </a>
                  ) : (
                    <span>{job.company}</span>
                  )}
                </h2>

                <p class="text-sm text-foreground/60 sm:text-right whitespace-nowrap">
                  <span class="font-medium">{job.start}</span> —{" "}
                  <span class="font-medium">{job.end}</span>
                </p>
              </div>

              {/* Location */}
              {job.location ? (
                <p class="text-sm text-foreground/60">{job.location}</p>
              ) : null}

              {/* Summary */}
              {job.summary ? (
                <p class="text-sm text-foreground/80 leading-relaxed">{job.summary}</p>
              ) : null}

              {/* Highlights */}
              {job.highlights?.length ? (
                <div class="mt-1">
                  <div class="text-sm font-semibold">Highlights</div>
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-foreground/80 leading-relaxed">
                    {job.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
              ) : null}

              {/* Stack tags */}
              {job.stack?.length ? (
                <div class="mt-2 flex flex-wrap gap-2">
                  {job.stack.map((t) => (
                    <span class="inline-flex items-center rounded-md border border-border bg-background/40 px-2 py-1 text-xs text-foreground/70">
                      {t}
                    </span>
                  ))}
                </div>
              ) : null}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- SKILLS -->
    <section id="skills" class:list={["pt-2 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-2xl font-bold sm:my-8 sm:text-4xl">Skills</h1>

      <div class="grid gap-4 sm:grid-cols-2">
        {skills.map((group) => (
          <div class="rounded-lg border border-border bg-neutral-secondary-soft p-6 shadow-sm">
            <h2 class="text-lg font-bold">{group.group}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((s) => (
                <span class="inline-flex items-center rounded-md border border-border bg-background/40 px-2 py-1 text-xs text-foreground/70">
                  {s}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- EDUCATION -->
    <section id="education" class="pt-2 pb-6">
      <h1 class="my-4 inline-block text-2xl font-bold sm:my-8 sm:text-4xl">Education</h1>

      <div class="grid gap-4">
        {education.map((e) => (
          <div class="rounded-lg border border-border bg-neutral-secondary-soft p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between mt-2 pb-4 gap-2">
              <div>
                <h2 class="text-lg font-bold leading-snug">{e.school}</h2>
                <p class="mt-3 text-sm text-foreground/80">{e.degree}</p>
              </div>
              <p class="text-sm text-foreground/60 sm:mt-1">
                {e.start} &mdash; {e.end}
              </p>
            </div>

            {e.details?.length ? (
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-foreground/80 leading-relaxed">
                {e.details.map((d) => (
                  <li set:html={d} />
                ))}
              </ul>
            ) : null}
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>