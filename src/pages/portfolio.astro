---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";

const experience = [
  {
    company: "SCM Group",
    role: "Embedded Linux Trainer & Consultant",
    start: "Nov 2024",
    end: "Present",
    location: "Rimini, Italy",
    url: "",
    summary:
      "Designed and delivered intensive embedded Linux training for hardware engineers, enabling teams to build custom distributions for industrial automation controllers.",
    highlights: [
      "Designed and delivered intensive embedded Linux training program for 15+ hardware engineers, covering BSP development, kernel configuration, and real-time systems.",
      "Taught Yocto Project build system, BitBake recipes, device tree customization, cross-compilation toolchains, and kernel module development.",
      "Enabled teams to build custom embedded Linux distributions for ARM-based industrial automation controllers.",
    ],
    stack: ["Embedded Linux", "Yocto Project", "BitBake", "ARM"],
  },
  {
    company: "HSG - University of St.Gallen",
    role: "Research Visiting",
    start: "March 2025",
    end: "June 2025",
    location: "St.Gallen, Switzerland",
    url: "",
    summary:
      "Researched effect systems for type-safe distributed system architectures and implemented a Scala 3 framework showcasing effects-as-capabilities in edge-cloud contexts.",
    highlights: [
      "Researched effect systems for type-safe distributed system architectures ensuring strong compile-time safety preventing unintended architectural violations.",
      "Implemented a Scala 3 framework showcasing the feasibility of the effects-as-capabilities approach in distributed edge-cloud architecture.",
    ],
    stack: ["Scala 3", "Effect Systems", "Distributed Systems", "Edge-Cloud"],
  },
  {
    company: "Alma Mater Studiorum - University of Bologna",
    role: "Research Fellow",
    start: "April 2023",
    end: "October 2023",
    location: "Cesena, Italy",
    url: "",
    summary:
      "Developed a framework for deploying large-scale IoT systems on edge-cloud architectures as part of the PRIN CommonWears research project.",
    highlights: [
      "Active member of the PRIN CommonWears (COMMunity-OrieNted WEARable Computing Systems — 2020HCWWLP).",
      "Developed a framework for deploying large-scale IoT systems on edge-cloud architectures and embedded devices.",
      "Implemented cross-platform deployment system supporting Linux SBCs and cloud infrastructure.",
      "Optimized embedded device communication using lightweight protocols (MQTT) for IoT applications.",
    ],
    stack: ["IoT", "Edge-Cloud", "MQTT", "Linux", "Embedded Systems"],
  },
  {
    company: "Alma Mater Studiorum - University of Bologna",
    role: "Tutor",
    start: "2020",
    end: "Present",
    location: "Cesena, Italy",
    url: "",
    summary:
      "Teaching assistant across multiple CS courses, mentoring 100+ students annually on programming languages, software design, and best practices.",
    highlights: [
      "Teaching assistant for Object-Oriented Programming, Algorithms and Data Structures, Programming Paradigms and Development, and Distributed and Concurrent Programming courses.",
      "Mentored 100+ students annually on Java, Scala, and C programming, software design principles, and best practices.",
    ],
    stack: ["Java", "Scala", "C", "Algorithms", "Distributed Systems"],
  },
];

const skills = [
  { group: "Programming Languages", items: ["Scala", "Kotlin", "Java", "Rust", "Python", "C/C++"] },
  { group: "Frameworks", items: ["Cats", "Cats Effect", "RabbitMQ", "MQTT"] },
  { group: "Tooling", items: ["Git", "Docker", "Kubernetes", "Postgres", "GitHub Actions", "Gradle", "Cargo", "Sbt", "IntelliJ", "VSCode"] },
  { group: "Methodologies", items: ["Agile", "Domain Driven Design", "Event Driven Architecture", "Functional Reactive Programming", "Test Driven Development"] },
  { group: "Soft Skills", items: ["Technical Leadership", "Communication", "Menthoring", "Collaboration"] }
];

const education = [
  {
    school: "University of Bologna",
    degree: "PhD program in Computer Science and Engineering",
    start: "November 2023",
    end: "Present",
    details: [
      "Developed novel deployment strategies for <strong>resource-constrained</strong> IoT devices in <strong>edge-cloud</strong> architectures, optimizing for reliability and resilience in large-scale distributed systems.",
      "Published and presented <strong>10+ papers</strong> in international conferences and journals related to IoT and distributed systems."
    ],
  },
  {
    school: "University of Bologna",
    degree: "M.Sc. Computer Science and Engineering",
    start: "September 2020",
    end: "March 2023",
    details: [
      "Relevant coursework: Algorithms, Databases, Web Development",
      'Thesis title: <em>Design and Implementation of a Portable Framework for Application Decomposition and Deployment for Edge-Cloud Systems</em>',
    ],
  },
  {
    school: "University of Bologna",
    degree: "B.Sc. Computer Science and Engineering",
    start: "September 2016",
    end: "March 2020",
    details: [
      "Relevant coursework: Algorithms, Databases, Web Development",
      "Capstone/Thesis: (optional) …",
    ],
  },
];
---

<Layout>
  <Header />

  <main id="main-content" class="app-layout">
    <!-- EXPERIENCE -->
    <section id="experience" class="pb-6 border-b border-border">
      <h1 class="my-4 inline-block text-2xl font-bold sm:my-8 sm:text-4xl">Experience</h1>

      <ol class="grid gap-4">
        {experience.map((job) => (
          <li class="relative rounded-lg border border-border bg-neutral-secondary-soft p-6 flex flex-col gap-2 shadow-sm">
            <div class="flex flex-col gap-3">
              {/* Top row: title + dates (dates right-aligned to title) */}
              <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-baseline">
                <div>
                  <h2 class="text-lg font-bold leading-snug">
                    <span>{job.role}</span>
                    <span class="text-foreground/60"> @ </span>
                    {job.url ? (
                      <a
                        class="underline decoration-dashed underline-offset-4 hover:text-foreground/75"
                        href={job.url}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {job.company}
                      </a>
                    ) : (
                      <span>{job.company}</span>
                    )}
                  </h2>
                  {job.location ? (
                    <p class="pt-1 text-sm text-foreground/80">{job.location}</p>
                  ) : null}
                </div>

                <p class="text-sm text-foreground/60 sm:text-right whitespace-nowrap">
                  <span class="font-medium">{job.start}</span> &mdash;{" "}
                  <span class="font-medium">{job.end}</span>
                </p>
              </div>

              {/* Summary */}
              {job.summary ? (
                <p class="text-sm text-foreground/80 leading-relaxed">{job.summary}</p>
              ) : null}

              {/* Highlights */}
              {job.highlights?.length ? (
                <div class="mt-1">
                  <div class="text-sm font-semibold">Highlights</div>
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-foreground/80 leading-relaxed">
                    {job.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
              ) : null}

              {/* Stack tags */}
              {job.stack?.length ? (
                <div class="mt-2 flex flex-wrap gap-2">
                  {job.stack.map((t) => (
                    <span class="inline-flex items-center rounded-md border border-border bg-background/40 px-2 py-1 text-xs text-foreground/70">
                      {t}
                    </span>
                  ))}
                </div>
              ) : null}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="pb-6 border-b border-border">
      <h1 class="my-4 inline-block text-2xl font-bold sm:my-8 sm:text-4xl">Skills</h1>

      <div class="grid gap-4 sm:grid-cols-2">
        {skills.map((group) => (
          <div class="rounded-lg border border-border bg-neutral-secondary-soft p-6 shadow-sm">
            <h2 class="text-lg font-bold">{group.group}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((s) => (
                <span class="inline-flex items-center rounded-md border border-border bg-background/40 px-2 py-1 text-xs text-foreground/70">
                  {s}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- EDUCATION -->
    <section id="education" class="pb-6">
      <h1 class="my-4 inline-block text-2xl font-bold sm:my-8 sm:text-4xl">Education</h1>

      <div class="grid gap-4">
        {education.map((e) => (
          <div class="rounded-lg border border-border bg-neutral-secondary-soft p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between mt-2 pb-2 gap-2">
              <div>
                <h2 class="text-lg font-bold leading-snug">{e.degree}</h2>
                <p class="pt-1 text-sm text-foreground/80">{e.school}</p>
              </div>
              <p class="text-sm text-foreground/60 sm:mt-1">
                {e.start} &mdash; {e.end}
              </p>
            </div>

            {e.details?.length ? (
              <ul class="mt-3 list-none space-y-1 text-sm text-foreground/80 leading-relaxed">
                {e.details.map((d) => (
                  <li><p set:html={d}>{d}</p></li>
                ))}
              </ul>
            ) : null}
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>