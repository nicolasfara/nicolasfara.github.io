---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Image from "astro/components/Image.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-2 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        About Me
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <!-- <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span> -->
      </a>

      <!-- Profile section with image and text -->
      <div class="mt-8 flex flex-col gap-12 sm:flex-row sm:items-start">
        <!-- Profile image -->
        <div class="flex-shrink-0">
          <Image width={48} height={48} src="/pic-square.jpg" loading={"eager"}
            alt="Nicolas Farabegoli portrait"
            class="h-48 w-48 rounded-full border-6 border-border object-cover"
          />
        </div>

        <!-- Text content -->
        <div class="flex-1">
          <blockquote class="p-4 my-4 border-s-4 border-default bg-neutral-secondary-soft">
            <p class="text-xl italic font-medium leading-relaxed text-heading">
              End-to-end software engineer</em><span>&#8212;</span>bridging the gap between <strong>edge microcontrollers</strong> and <strong>cloud systems</strong>.
            </p>
          </blockquote>
          <p class="mt-4">
            As a <strong>Ph.D. researcher</strong> at the <em>University of Bologna</em>, I work on deployment strategies for IoT devices in edge-cloud environments—basically figuring out how to make thousands of tiny computers work together reliably.
            I've published more than
            <LinkButton class="underline decoration-dashed underline-offset-4 hover:text-foreground/75" href="https://scholar.google.com/citations?user=d3k7EVUAAAAJ&hl=it"><strong>10 papers</strong></LinkButton>
            on these topics and regularly speak at conferences about distributed systems and collective adaptive computing.
          </p>
          <p class="mt-4">
            My day-to-day involves writing <em>embedded firmware</em> for ARM microcontrollers, and architecting functional cloud-native applications.
            I'm a strong believer in bringing modern software practices—<em>memory safety, type systems, async runtimes</em>—to the embedded world where they're often overlooked.
            I also work with functional languages like <em>Scala</em>, applying <em>Domain Driven Design</em> principles to build systems where the code structure mirrors the problem domain.
          </p>
          <p class="mt-4">
            I maintain several <LinkButton class="underline decoration-dashed underline-offset-4 hover:text-foreground/75" href="https://github.com/nicolasfara">open-source projects</LinkButton> in swarm robotics and edge computing, teach university courses on programming and distributed systems, and occasionally consult on embedded Linux and IoT architecture.
            Outside of tech, I'm usually on a <em>mountain bike trail</em> or designing PCBs for my next robotics experiment.
          </p>
        </div>
      </div>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    } -->

    <!-- <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div> -->
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
